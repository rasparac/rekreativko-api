# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Delve debug binaries (e.g. __debug_bin2115136243) left behind by VS Code's Go debugger
__debug_bin*

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

local.env
service
service-*

.vscode/

vendor/

.env

