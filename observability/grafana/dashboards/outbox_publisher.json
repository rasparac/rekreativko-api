                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "Prometheus"
                    },
                    "expr": "sum(rate(events_published_total{service=\"outbox-publisher\"}[$__rate_interval]))",
                    "legendFormat": "events/s",
                    "refId": "A"
