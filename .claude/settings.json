{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-commit-ticket-writer.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bd *)",
      "Bash(git *)"
    ],
    "ask": [
      "Bash(bd delete *)",
      "Bash(bd dolt push --force*)"
    ]
  }
}